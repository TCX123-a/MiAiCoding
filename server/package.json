{
  "name": "miai-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "咪爱编程 自建后端（P10.2：账号体系、四文档同步、挑战/排行/大白饭）",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:pg": "node scripts/test-pg.mjs",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:built": "node dist/db/migrate.js",
    "openapi:snapshot": "tsx scripts/openapi-snapshot.ts",
    "job:daily": "tsx src/jobs/daily.ts",
    "gen:notices": "node ../scripts/gen-third-party-notices.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
