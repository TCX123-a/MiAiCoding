# miai-server 环境变量示例。复制为 server/.env 后填真值；.env 不进 git（见 .gitignore）。
# 缺失必填项时进程启动即失败（src/config.ts 校验）。

# development | test | production（缺省 development）
NODE_ENV=development

# 监听地址与端口（缺省 127.0.0.1:8787；生产在 compose 内网里监听）
HOST=127.0.0.1
PORT=8787

# pino 日志级别（缺省 info）
LOG_LEVEL=info

# 应用连接串（miai_app 角色，仅 DML）。必填。
DATABASE_URL=postgres://miai_app:REPLACE_ME@127.0.0.1:5432/miai

# 迁移连接串（miai_owner 角色）。仅 `npm run migrate` 使用，绝不进应用启动路径。
# 生产环境必填，且必须与 DATABASE_URL 不同（混用即启动失败）；开发环境可省略（回退 DATABASE_URL）。
MIGRATION_DATABASE_URL=postgres://miai_owner:REPLACE_ME@127.0.0.1:5432/miai

# 反向代理信任网段（生产 = 现役网络实况段——2026-10-12 实测 172.18.0.0/16；deploy.sh 会与 network inspect 实况对账；本机开发留空）
TRUST_PROXY_CIDR=

# 限流覆盖项（留空 = 用 docs/22 §5.4 默认值，见 server/README.md）
RATE_LIMIT_REGISTER_PER_HOUR=
RATE_LIMIT_REGISTER_GLOBAL_PER_DAY=
RATE_LIMIT_LOGIN_PER_15MIN=
RATE_LIMIT_API_PER_MINUTE=
RATE_LIMIT_CHALLENGE_PER_DAY=
RATE_LIMIT_RICE_PUSH_PER_HOUR=
RATE_LIMIT_RICE_ENTRIES_PER_PUSH=
RATE_LIMIT_RICE_ENTRIES_PER_DAY=
RATE_LIMIT_AVATAR_PER_HOUR=
RATE_LIMIT_PASSWORD_CHANGE_PER_DAY=
RATE_LIMIT_USERNAME_CHANGE_PER_DAY=
RATE_LIMIT_DELETE_ACCOUNT_PER_DAY=
RATE_LIMIT_DOCS_WRITE_PER_HOUR=

# —— 部署侧键（仅部署窗口现场使用；应用代码不读，本机开发不需要）——
# 服务器公网 IP（部署脚本 / 健康检查 / 证书观察脚本引用）
SERVER_IP=
